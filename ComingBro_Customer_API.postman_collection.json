            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\",\n  \"driver_id\": 1,\n  \"payment_status\": false,\n  \"payment_type\": \"cash\",\n  \"final_rate\": 120.00,\n  \"otp\": \"4521\",\n  \"accepted_driver_id\": 1,\n  \"rejected_driver_id\": null,\n  \"ride_hold_time\": 0,\n  \"holding_charges\": 0,\n  \"total_holding_charges\": 0,\n  \"position_latitude\": 28.6315,\n  \"position_longitude\": 77.2167,\n  \"position_geohash\": \"tt3g\",\n  \"total_ride_time\": 0,\n  \"ac_non_ac_charges\": 0,\n  \"coupon\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/orders/{{order_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "customer", "orders", "{{order_id}}"]
            },
            "description": "Update order status, driver assignment, payment. Setting payment_status to true triggers wallet transactions."
          }
        },
        {
          "name": "Get Accepted Drivers for Order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
