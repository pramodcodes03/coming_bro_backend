        {
          "name": "Check If First Order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/customer/orders/first-order/{{customer_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "customer", "orders", "first-order", "{{customer_id}}"]
