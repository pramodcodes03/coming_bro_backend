{
  "info": {
    "name": "ComingBro Customer API",
    "description": "Complete customer API collection for ComingBro ride-hailing platform. Covers authentication, profile, orders, intercity orders, wallet, chat, reviews, referrals, and SOS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "comingbro-customer-api-v1"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://comingbro.nextgeniusinfotech.com",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Bearer token from OTP verify or social login"
    },
    {
      "key": "customer_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "intercity_order_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "driver_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "verification_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.verification_id) {",
                  "    pm.collectionVariables.set('verification_id', res.data.verification_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"9876543210\",\n  \"country_code\": \"+91\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/send-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "customer", "send-otp"]
            },
            "description": "Send OTP to customer phone number. Saves verification_id to collection variable."
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "}",
                  "if (res.success && res.data && res.data.customer) {",
                  "    pm.collectionVariables.set('customer_id', res.data.customer.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verification_id\": \"{{verification_id}}\",\n  \"otp\": \"123456\",\n  \"phone_number\": \"9876543210\",\n  \"country_code\": \"+91\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "customer", "verify-otp"]
            },
            "description": "Verify OTP. Saves token and customer_id to collection variables."
          }
        },
        {
          "name": "Social Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "}",
                  "if (res.success && res.data && res.data.customer) {",
                  "    pm.collectionVariables.set('customer_id', res.data.customer.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_type\": \"google\",\n  \"email\": \"user@example.com\",\n  \"full_name\": \"John Doe\",\n  \"profile_pic\": \"https://example.com/pic.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/social-login",
              "host": ["{{base_url}}"],
              "path": ["api", "customer", "social-login"]
            },
            "description": "Login with Google or Apple. login_type: 'google' | 'apple'"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/customer/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "customer", "logout"]
            },
            "description": "Revokes current bearer token."
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/customer/delete-account",
              "host": ["{{base_url}}"],
              "path": ["api", "customer", "delete-account"]
            },
            "description": "Permanently deletes authenticated customer account and all tokens."
          }
        }
      ]
    },
