    {
      "name": "5. City Orders",
      "item": [
        {
          "name": "Create City Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('order_id', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_location_name\": \"Connaught Place, New Delhi\",\n  \"destination_location_name\": \"India Gate, New Delhi\",\n  \"payment_type\": \"cash\",\n  \"source_latitude\": 28.6315,\n  \"source_longitude\": 77.2167,\n  \"destination_latitude\": 28.6129,\n  \"destination_longitude\": 77.2295,\n  \"service_id\": 1,\n  \"offer_rate\": 120.00,\n  \"final_rate\": 120.00,\n  \"distance\": 3.5,\n  \"duration\": 15,\n  \"distance_type\": \"km\",\n  \"status\": \"searching\",\n  \"otp\": \"4521\",\n  \"is_ac_selected\": false,\n  \"tax_list\": [],\n  \"some_one_else\": null,\n  \"coupon\": null,\n  \"service\": {},\n  \"admin_commission\": {},\n  \"zone\": {},\n  \"zone_id\": 1,\n  \"position_latitude\": 28.6315,\n  \"position_longitude\": 77.2167,\n  \"position_geohash\": \"tt3g\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "customer", "orders"]
            },
            "description": "Creates a new city ride order. Saves order_id to collection variable."
          }
        },
        {
          "name": "Get City Order Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/customer/orders/{{order_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "customer", "orders", "{{order_id}}"]
            }
          }
        },
