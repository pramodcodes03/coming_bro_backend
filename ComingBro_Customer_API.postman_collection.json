            "url": {
              "raw": "{{base_url}}/api/customer/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "customer", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"profile_pic\": \"https://example.com/pic.jpg\",\n  \"fcm_token\": \"fcm-token-here\",\n  \"country_code\": \"+91\",\n  \"phone_number\": \"9876543210\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customer/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "customer", "profile"]
            },
            "description": "All fields are optional. Only send fields you want to update."
          }
        },
        {
          "name": "Update FCM Token",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcm_token\": \"your-fcm-device-token-here\"\n}"
            },
            "url": {
