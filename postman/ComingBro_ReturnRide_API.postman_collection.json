{
  "info": {
    "name": "ComingBro Return Ride API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Return Ride = scheduled-ride bidding. Customers post scheduled rides; recharged drivers submit fare offers; the customer accepts one (others auto-rejected) and the ride is handed off to the standard Order execution flow."
  },
  "item": [
    {
      "name": "0. Auth (get tokens)",
      "item": [
        {
          "name": "Driver send-otp",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/driver/send-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driver",
                "send-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"9300000001\",\n  \"country_code\": \"+91\"\n}"
            }
          }
        },
        {
          "name": "Driver verify-otp",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/driver/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driver",
                "verify-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"9300000001\",\n  \"country_code\": \"+91\",\n  \"otp\": \"123456\",\n  \"verification_id\": \"{{driver_verification_id}}\"\n}"
            }
          }
        },
        {
          "name": "Customer send-otp",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customer/send-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "send-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"9000000001\",\n  \"country_code\": \"+91\"\n}"
            }
          }
        },
        {
          "name": "Customer verify-otp",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customer/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "verify-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"9000000001\",\n  \"country_code\": \"+91\",\n  \"otp\": \"123456\",\n  \"verification_id\": \"{{customer_verification_id}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "1. Customer - Scheduled Return Rides",
      "item": [
        {
          "name": "Create scheduled return ride",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customer/return-rides",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "return-rides"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup_location_name\": \"Pune Airport\",\n  \"pickup_latitude\": 18.5793,\n  \"pickup_longitude\": 73.9089,\n  \"drop_location_name\": \"Thane\",\n  \"drop_latitude\": 19.2183,\n  \"drop_longitude\": 72.9781,\n  \"passengers\": 2,\n  \"scheduled_at\": \"2026-06-26T18:30:00+05:30\",\n  \"payment_type\": \"cash\",\n  \"distance\": \"120\",\n  \"distance_type\": \"Km\",\n  \"duration\": \"2h 30m\"\n}"
            },
            "description": "Customer posts a scheduled ride requirement. Status=Scheduled, open for driver offers."
          }
        },
        {
          "name": "My scheduled rides",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customer/return-rides",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "return-rides"
              ]
            },
            "description": "List the customer's scheduled rides with pending-offer counts and assigned driver/order once accepted."
          }
        },
        {
          "name": "Ride detail (with offers)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customer/return-rides/{{return_ride_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "return-rides",
                "{{return_ride_id}}"
              ]
            }
          }
        },
        {
          "name": "Offers on a ride",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customer/return-rides/{{return_ride_id}}/offers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "return-rides",
                "{{return_ride_id}}",
                "offers"
              ]
            },
            "description": "Driver offers (driver details, vehicle, rating, fare, notes) for review."
          }
        },
        {
          "name": "Accept an offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customer/return-rides/{{return_ride_id}}/offers/{{offer_id}}/accept",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "return-rides",
                "{{return_ride_id}}",
                "offers",
                "{{offer_id}}",
                "accept"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Accepts the chosen driver; auto-rejects the rest and spawns a normal Order for execution."
          }
        },
        {
          "name": "Reject an offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customer/return-rides/{{return_ride_id}}/offers/{{offer_id}}/reject",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "return-rides",
                "{{return_ride_id}}",
                "offers",
                "{{offer_id}}",
                "reject"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Cancel scheduled ride",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/customer/return-rides/{{return_ride_id}}/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "customer",
                "return-rides",
                "{{return_ride_id}}",
                "cancel"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Driver - Offers & Recharge",
      "item": [
        {
          "name": "Recharge status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/driver/return-rides/recharge-status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driver",
                "return-rides",
                "recharge-status"
              ]
            },
            "description": "Whether the driver holds an active Return Ride recharge."
          }
        },
        {
          "name": "Purchase recharge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/driver/return-rides/recharge",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driver",
                "return-rides",
                "recharge"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_type\": \"online\"\n}"
            },
            "description": "Activates the Return Ride feature (3-month validity)."
          }
        },
        {
          "name": "Browse scheduled rides (gated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/driver/return-rides/available",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driver",
                "return-rides",
                "available"
              ]
            },
            "description": "Open customer scheduled rides with distance-from-driver and the driver's own offer status. Requires active recharge (403 RETURN_RIDE_RECHARGE_REQUIRED otherwise)."
          }
        },
        {
          "name": "Ride detail (driver view)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/driver/return-rides/{{return_ride_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driver",
                "return-rides",
                "{{return_ride_id}}"
              ]
            }
          }
        },
        {
          "name": "Book Return Ride (submit offer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/driver/return-rides/{{return_ride_id}}/offers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driver",
                "return-rides",
                "{{return_ride_id}}",
                "offers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offered_fare\": 350,\n  \"description\": \"AC sedan, 5 min away.\"\n}"
            },
            "description": "Submit/update a fare offer (price + optional description) on a scheduled ride."
          }
        },
        {
          "name": "My offers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/driver/return-ride-offers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driver",
                "return-ride-offers"
              ]
            }
          }
        },
        {
          "name": "Withdraw offer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/driver/return-ride-offers/{{offer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driver",
                "return-ride-offers",
                "{{offer_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://comingbro.nextgeniusinfotech.com"
    },
    {
      "key": "driver_token",
      "value": ""
    },
    {
      "key": "customer_token",
      "value": ""
    },
    {
      "key": "driver_verification_id",
      "value": ""
    },
    {
      "key": "customer_verification_id",
      "value": ""
    },
    {
      "key": "return_ride_id",
      "value": ""
    },
    {
      "key": "offer_id",
      "value": ""
    }
  ]
}