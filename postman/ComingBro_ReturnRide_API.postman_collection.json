{
  "info": {
    "name": "ComingBro Return Ride API",
    "description": "Return Ride feature API collection. A driver publishes their return journey; passengers discover it along the corridor within a pickup time window and book a seat.\n\nOrder of use:\n1. Run '0. Auth' to populate {{driver_token}} and {{customer_token}}.\n2. Driver: 'Publish Return Ride' (sets {{return_ride_id}}).\n3. Customer: 'Discover' then 'Book Return Ride' (sets {{return_ride_booking_id}}).\n\nAll sample data uses Indian names, phone numbers (+91) and the Pune Airport -> Thane corridor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "comingbro-return-ride-api-v1"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://comingbro.nextgeniusinfotech.com",
      "type": "string"
    },
    {
      "key": "driver_token",
      "value": "",
      "type": "string",
      "description": "Bearer token for the driver (auth:sanctum)"
    },
    {
      "key": "customer_token",
      "value": "",
      "type": "string",
      "description": "Bearer token for the customer (auth:customer)"
    },
    {
      "key": "driver_verification_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_verification_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "return_ride_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "return_ride_booking_id",
      "value": "",
      "type": "string"
    }
  ],
