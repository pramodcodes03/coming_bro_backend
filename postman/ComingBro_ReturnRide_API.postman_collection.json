              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/driver/send-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driver",
                "send-otp"
              ]
            },
            "description": "Driver Rohan Deshmukh requests an OTP.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"9822012345\",\n  \"country_code\": \"+91\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "try {",
                  "    var v = res; v = v && v[\"data\"];v = v && v[\"verification_id\"];",
